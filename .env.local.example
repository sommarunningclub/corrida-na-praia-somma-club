# Supabase — projeto compartilhado Somma (riqfjewvygqsbuokvsjw)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Obrigatória: a tabela tem RLS sem policies, o insert só passa por aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — precisa da Maps JavaScript API habilitada na chave
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend — e-mail de confirmação da Lista VIP
RESEND_API_KEY=
VIP_EMAIL_FROM="Corrida na Praia <contato@sommaclub.com.br>"

# Painel /admin — dois códigos, dois papéis.
# OBRIGATÓRIAS: este repositório é público, então os códigos não podem ter
# valor padrão no fonte. Sem elas o painel não deixa ninguém entrar.
# Editor: vê tudo e altera (criar, editar, excluir, exportar, fechar o form).
ADMIN_ACCESS_CODE=
# Leitor: só consulta. Escrita barrada no servidor e cópia travada na tela.
ADMIN_VIEW_CODE=
# Opcional: segredo que assina o cookie de sessão do painel. Sem isso, deriva
# da service role key. Definir invalida as sessões abertas.
ADMIN_SESSION_SECRET=

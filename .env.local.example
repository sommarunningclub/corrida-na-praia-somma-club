# Supabase — projeto compartilhado Somma (riqfjewvygqsbuokvsjw)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Obrigatória: a tabela tem RLS sem policies, o insert só passa por aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — precisa da Maps JavaScript API habilitada na chave
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend — e-mail de confirmação da Lista VIP
RESEND_API_KEY=
VIP_EMAIL_FROM="Corrida na Praia <contato@sommaclub.com.br>"

# Painel /admin — código de acesso da equipe.
# OBRIGATÓRIA: este repositório é público, então o código não pode ter valor
# padrão no fonte. Sem esta variável o painel não deixa ninguém entrar.
ADMIN_ACCESS_CODE=
# Opcional: segredo que assina o cookie de sessão do painel. Sem isso, deriva
# da service role key. Definir invalida as sessões abertas.
ADMIN_SESSION_SECRET=
